# Public browser configuration. The publishable key is RLS-limited and is not a secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DEMO_MODE=true
DEFAULT_TIMEZONE=Asia/Kolkata

# Server-only configuration. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVER_SECRET=
INGEST_TOKEN_PEPPER=
FIT_WORKER_URL=http://127.0.0.1:8000
FIT_WORKER_INTERNAL_TOKEN=
RAW_SAMPLE_RETENTION_DAYS=30
RAW_FIT_RETENTION_MODE=delete_after_parse

# Every integration is default-off and separately reversible.
ENABLE_AI_NARRATIVE=false
ENABLE_LOCAL_LLM=false
ENABLE_HUGGINGFACE_PROVIDER=false
ENABLE_OPENAI_PROVIDER=false
ENABLE_AGENT_RUNTIME=false
ENABLE_HEALTH_MCP=false
ENABLE_CHATGPT_APP=false
ENABLE_CODEX_MCP=false
ENABLE_CHATGPT_WIDGET=false
ENABLE_FUTURE_AGENT_WRITES=false
ENABLE_PUBLIC_MCP=false
ENABLE_RAW_HEALTH_TO_AI=false
ENABLE_NOTES_TO_AI=false
ENABLE_GPS_TO_AI=false
ENABLE_MEDICATION_DATA=false
ENABLE_PUBLIC_SIGNUP=false
ENABLE_GARMIN_CLOUD_API=false
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=
LOCAL_LLM_TIMEOUT_MS=12000
LOCAL_LLM_MAX_OUTPUT_TOKENS=600
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
HEALTH_MCP_BIND_HOST=127.0.0.1
HEALTH_MCP_PORT=8787
HEALTH_MCP_ISSUER=
HEALTH_MCP_AUDIENCE=
